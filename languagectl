#!/bin/bash

# Backend for the OmaLangy bar widget (blackcode.omalangy).
#
# Keyboard languages and the plugin's keybindings are written to their own
# Hyprland module, ~/.config/hypr/keyboard-languages.lua, which hyprland.lua
# loads last through a pcall'd require. Nothing else in the user's config is
# rewritten, and a missing or broken module can never stop Hyprland loading.
#
#   languagectl state
#       JSON: layouts, variants, options, active index, keybinding status
#   languagectl apply <layouts> <variants> <switch-keys> <next-key> <panel-key>
#       e.g. apply "us,ara" "," alts "SUPER + SHIFT + K" "SUPER + CTRL + ALT + K"
#       switch-keys: alts | menu | rctrl | off     (an empty key turns a binding off)
#   languagectl check
#       drop any of our keybindings that something else has since claimed
#   languagectl switch <index|next|prev>
#   languagectl setup
#       first run only (the widget runs it on start): take the built-in keyboard
#       label's place on the bar, and turn the default shortcuts on
#   languagectl uninstall

set -euo pipefail

HYPR_DIR="$HOME/.config/hypr"
MODULE_NAME="keyboard-languages"
MODULE_FILE="$HYPR_DIR/$MODULE_NAME.lua"
HYPRLAND_FILE="$HYPR_DIR/hyprland.lua"
HOOK_MARKER="-- Keyboard languages from the bar (OmaLangy plugin)."
OLD_HOOK_MARKER="-- Keyboard languages from the bar (blackcode.language plugin)."
# Bump when the generated module changes shape, so existing installs rewrite it.
MODULE_FORMAT=2
HOOK_LINE="pcall(require, \"hypr.$MODULE_NAME\")"
LOCK_DIR="${XDG_RUNTIME_DIR:-$HOME/.cache}"
LOCK_FILE="$LOCK_DIR/omalangy.lock"

SHELL_JSON="${OMALANGY_SHELL_JSON:-$HOME/.config/omarchy/shell.json}"
STATE_DIR="${OMALANGY_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/omalangy}"
SETUP_MARKER="$STATE_DIR/setup-done"
REPLACED_FILE="$STATE_DIR/replaced-keyboard-layout.json"
MANIFEST="$(dirname "$(readlink -f "$0")")/manifest.json"
NEXT_DESC="Next keyboard language"
PANEL_DESC="Keyboard languages"

fail() {
  echo "languagectl: $*" >&2
  exit 1
}

option_str() {
  hyprctl -j getoption "$1" 2>/dev/null | jq -r '.str // ""'
}

# Switch keys handled by xkb itself. Only combinations Omarchy leaves free:
# Shift+Alt (Alt+Tab back, web-app shortcuts) and Ctrl+Shift (terminal
# copy/paste) are taken, Caps Lock is the compose key, both Shifts are Caps
# Lock, and Super+Space is the launcher.
xkb_toggle() {
  case "$1" in
  alts) echo "grp:alts_toggle" ;;
  menu) echo "grp:menu_toggle" ;;
  rctrl) echo "grp:rctrl_toggle" ;;
  off | "") echo "" ;;
  *) fail "unknown switch keys: $1 (use alts, menu, rctrl or off)" ;;
  esac
}

# "SUPER + SHIFT + K" -> "65|K", the shape `hyprctl binds -j` reports.
combo_id() {
  local combo="$1" mask=0 key="" part
  IFS='+' read -ra parts <<<"$combo"
  for part in "${parts[@]}"; do
    part=$(echo "$part" | tr -d '[:space:]' | tr '[:lower:]' '[:upper:]')
    case "$part" in
    SHIFT) mask=$((mask | 1)) ;;
    CAPS) mask=$((mask | 2)) ;;
    CTRL | CONTROL) mask=$((mask | 4)) ;;
    ALT) mask=$((mask | 8)) ;;
    SUPER | WIN | LOGO | MOD4) mask=$((mask | 64)) ;;
    "") ;;
    *) key="$part" ;;
    esac
  done
  [[ -n $key ]] || return 1
  echo "$mask|$key"
}

valid_combo() {
  [[ $1 =~ ^[A-Za-z0-9_\ +]+$ ]] && combo_id "$1" >/dev/null
}

# Description of whatever else (not this plugin) is bound to a combo, if anything.
bound_elsewhere() {
  local id="$1"
  hyprctl -j binds 2>/dev/null | jq -r --arg id "$id" --arg a "$NEXT_DESC" --arg b "$PANEL_DESC" '
    .[] | select("\(.modmask)|\(.key | ascii_upcase)" == $id)
        | select(.description != $a and .description != $b)
        | (if (.description // "") != "" then .description else "\(.dispatcher) \(.arg)" end)' | head -1
}

# The module was written by this version of the plugin.
module_current() {
  [[ -f $MODULE_FILE ]] && grep -qxF -e "-- format: $MODULE_FORMAT" "$MODULE_FILE"
}

saved_args() {
  [[ -f $MODULE_FILE ]] || return 0
  sed -n 's/^-- args: //p' "$MODULE_FILE" | head -1
}

key_status() {
  local combo="$1" desc="$2" id other
  if [[ -z $combo ]] || ! id=$(combo_id "$combo"); then
    echo '{"combo":"","status":"off","conflict":""}'
    return
  fi
  other=$(bound_elsewhere "$id")
  if [[ -n $other ]]; then
    jq -cn --arg c "$combo" --arg o "$other" '{combo: $c, status: "conflict", conflict: $o}'
  elif hyprctl -j binds | jq -e --arg d "$desc" 'any(.[]; .description == $d)' >/dev/null; then
    jq -cn --arg c "$combo" '{combo: $c, status: "active", conflict: ""}'
  else
    jq -cn --arg c "$combo" '{combo: $c, status: "pending", conflict: ""}'
  fi
}

state() {
  local devices args next_key="" panel_key=""
  devices=$(hyprctl -j devices 2>/dev/null || echo '{"keyboards":[]}')
  args=$(saved_args)
  if [[ -n $args ]]; then
    next_key=$(cut -d'|' -f4 <<<"$args")
    panel_key=$(cut -d'|' -f5 <<<"$args")
  fi

  jq -cn \
    --arg layouts "$(option_str input:kb_layout)" \
    --arg variants "$(option_str input:kb_variant)" \
    --arg options "$(option_str input:kb_options)" \
    --argjson devices "$devices" \
    --argjson nextKey "$(key_status "$next_key" "$NEXT_DESC")" \
    --argjson panelKey "$(key_status "$panel_key" "$PANEL_DESC")" \
    --arg applied "$args" \
    --argjson current "$(module_current && echo true || echo false)" '
    ($devices | [.keyboards[] | select(.name | test("^(hl-virtual-keyboard|power-button|sleep-button|lid-switch|video-bus)") | not)]) as $kbs
    | (($kbs | map(select(.main)) | first) // ($kbs | max_by(.active_layout_index // 0)) // {}) as $kb
    | {
        layouts: ($layouts | split(",")),
        variants: ($variants | split(",")),
        options: $options,
        active: ($kb.active_layout_index // 0),
        activeKeymap: ($kb.active_keymap // ""),
        applied: $applied,
        current: $current,
        nextKey: $nextKey,
        panelKey: $panelKey
      }'
}

valid_list() {
  [[ $1 =~ ^[A-Za-z0-9_,-]*$ ]]
}

lua_str() {
  printf '"%s"' "${1//\"/\\\"}"
}

ensure_hook() {
  [[ -f $HYPRLAND_FILE ]] || fail "$HYPRLAND_FILE not found"
  grep -qF -e "$HOOK_LINE" "$HYPRLAND_FILE" && return 0

  cp "$HYPRLAND_FILE" "$HYPRLAND_FILE.bak.$(date +%s)"
  printf '\n%s\n%s\n' "$HOOK_MARKER" "$HOOK_LINE" >>"$HYPRLAND_FILE"
}

apply() {
  local layouts="${1:-}" variants="${2:-}" switch_keys="${3:-alts}" next_key="${4:-}" panel_key="${5:-}"

  [[ -n $layouts ]] || fail "no layouts given"
  valid_list "$layouts" || fail "invalid layouts: $layouts"
  valid_list "$variants" || fail "invalid variants: $variants"
  [[ -z $next_key ]] || valid_combo "$next_key" || fail "invalid keybinding: $next_key"
  [[ -z $panel_key ]] || valid_combo "$panel_key" || fail "invalid keybinding: $panel_key"
  if [[ -n $next_key && -n $panel_key && $(combo_id "$next_key") == $(combo_id "$panel_key") ]]; then
    fail "both keybindings are $next_key; pick two different ones"
  fi

  local toggle
  toggle=$(xkb_toggle "$switch_keys")

  # Keep every option the user already has (compose key, caps lock, ...) and
  # replace only the layout-switch shortcut.
  local base options
  base=$(option_str input:kb_options | tr ',' '\n' | grep -v '^grp:' | grep -v '^$' | paste -sd, || true)
  options="$base"
  if [[ -n $toggle && $layouts == *,* ]]; then
    options="${options:+$options,}$toggle"
  fi
  [[ $options =~ ^[A-Za-z0-9_:,()+-]*$ ]] || fail "unexpected kb_options: $options"

  # Never bind over something Omarchy (or the user) already uses.
  local binds="" other warnings=()
  if [[ -n $next_key ]]; then
    other=$(bound_elsewhere "$(combo_id "$next_key")")
    if [[ -n $other ]]; then
      warnings+=("$next_key is already \"$other\"; next-language shortcut left off")
    else
      binds+="  o.bind($(lua_str "$next_key"), $(lua_str "$NEXT_DESC"), \"hyprctl switchxkblayout all next\")"$'\n'
    fi
  fi
  if [[ -n $panel_key ]]; then
    other=$(bound_elsewhere "$(combo_id "$panel_key")")
    if [[ -n $other ]]; then
      warnings+=("$panel_key is already \"$other\"; panel shortcut left off")
    else
      binds+="  o.bind($(lua_str "$panel_key"), $(lua_str "$PANEL_DESC"), \"omarchy-shell -q blackcode.omalangy toggle\")"$'\n'
    fi
  fi

  local config="hl.config({ input = { kb_layout = \"$layouts\", kb_variant = \"$variants\", kb_options = \"$options\" } })"

  mkdir -p "$HYPR_DIR"
  local tmp
  tmp=$(mktemp "$HYPR_DIR/.$MODULE_NAME.XXXXXX")
  {
    echo "-- Managed by the OmaLangy Omarchy bar plugin (blackcode.omalangy)."
    echo "-- format: $MODULE_FORMAT"
    echo "-- Change languages and shortcuts from the keyboard icon on the bar; edits here are overwritten."
    echo "-- args: $layouts|$variants|$switch_keys|$next_key|$panel_key"
    echo "$config"
    if [[ -n $binds ]]; then
      echo
      echo "if o and o.bind then"
      printf '%s' "$binds"
      echo "end"
    fi
  } >"$tmp"

  # Skip the reload entirely when nothing changed.
  if [[ -f $MODULE_FILE ]] && cmp -s "$tmp" "$MODULE_FILE"; then
    rm -f "$tmp"
  else
    mv "$tmp" "$MODULE_FILE"
    ensure_hook
    hyprctl reload config-only >/dev/null
  fi

  local w
  for w in "${warnings[@]}"; do echo "$w" >&2; done
  return 0
}

# Run after every config reload: if an Omarchy update or the user's own
# bindings.lua now uses one of our shortcuts, rewrite the module without it so
# the two never fire together.
check() {
  local args key id conflict=""
  args=$(saved_args)
  [[ -n $args ]] || return 0

  local l v s n p
  IFS='|' read -r l v s n p <<<"$args"
  for key in "$n" "$p"; do
    [[ -n $key ]] || continue
    id=$(combo_id "$key") || continue
    if [[ -n $(bound_elsewhere "$id") ]] && grep -qF -e "o.bind($(lua_str "$key")" "$MODULE_FILE"; then
      conflict="$key"
    fi
  done
  [[ -n $conflict ]] || return 0

  local out
  out=$(apply "$l" "$v" "$s" "$n" "$p" 2>&1 || true)
  if [[ -n $out ]]; then
    command -v notify-send >/dev/null && notify-send -a "OmaLangy" "Shortcut turned off" "$out" || true
    echo "$out" >&2
  fi
}

switch_layout() {
  local target="${1:-next}"
  [[ $target =~ ^([0-9]+|next|prev)$ ]] || fail "invalid layout: $target"
  hyprctl switchxkblayout all "$target" >/dev/null
}

# ---- Zero configuration (1.4) -------------------------------------------------------

# Writes shell.json atomically, keeping its mode.
write_shell_json() {
  local tmp
  tmp=$(mktemp "$SHELL_JSON.XXXXXX")
  if ! { printf '%s\n' "$1" >"$tmp" && chmod --reference="$SHELL_JSON" "$tmp" && mv "$tmp" "$SHELL_JSON"; }; then
    rm -f "$tmp"
    fail "could not write $SHELL_JSON (left unchanged)"
  fi
}

JQ_FIND='def find(id): first(["left", "center", "right"][] as $s | (.bar.layout[$s] // []) | to_entries[]
  | select(.value.id == id) | {s: $s, i: .key}) // null;'

# OmaLangy takes the built-in label's place: the same section and position. The built-in
# entry (with any settings it had) is saved so uninstall can put it back.
setup_bar() {
  [[ -f $SHELL_JSON ]] || { echo "no $SHELL_JSON: bar left as it is"; return 0; }
  local where next
  where=$(jq -c "$JQ_FIND"' {kb: find("omarchy.keyboard-layout"), me: find("blackcode.omalangy")}' "$SHELL_JSON") ||
    { echo "$SHELL_JSON is not valid JSON: bar left as it is"; return 0; }
  if [[ $(jq -r '.kb == null' <<<"$where") == true ]]; then echo "the built-in keyboard label is not on the bar: nothing to replace"; return 0; fi
  if [[ $(jq -r '.me == null' <<<"$where") == true ]]; then echo "OmaLangy is not on the bar yet: built-in label left in place"; return 0; fi
  mkdir -p "$STATE_DIR"
  jq -c "$JQ_FIND"' find("omarchy.keyboard-layout") as $kb | {section: $kb.s, index: $kb.i, entry: .bar.layout[$kb.s][$kb.i]}' \
    "$SHELL_JSON" >"$REPLACED_FILE"
  next=$(jq "$JQ_FIND"'
    find("blackcode.omalangy") as $me | .bar.layout[$me.s][$me.i] as $entry
    | .bar.layout[$me.s] |= del(.[$me.i])
    | find("omarchy.keyboard-layout") as $kb
    | .bar.layout[$kb.s][$kb.i] = $entry' "$SHELL_JSON")
  write_shell_json "$next"
  echo "OmaLangy now sits where the built-in keyboard label was ($(jq -r '.section' "$REPLACED_FILE"))"
}

# The default shortcuts and switch keys from the manifest, applied to the layouts Hyprland
# already has. apply keeps every other keyboard option and skips keys that are taken.
setup_keys() {
  [[ -f $MODULE_FILE ]] && { echo "keyboard module already there: shortcuts left as they are"; return 0; }
  local layouts variants switch next panel
  layouts=$(option_str input:kb_layout)
  variants=$(option_str input:kb_variant)
  [[ -n $layouts ]] || layouts=us
  switch=$(jq -r '.barWidget.defaults.switchKeys // "Both Alt keys"' "$MANIFEST")
  case $switch in "Menu key") switch=menu ;; "Right Ctrl") switch=rctrl ;; Off) switch=off ;; *) switch=alts ;; esac
  next=$(jq -r '.barWidget.defaults.nextLanguageKey // ""' "$MANIFEST")
  panel=$(jq -r '.barWidget.defaults.panelKey // ""' "$MANIFEST")
  apply "$layouts" "$variants" "$switch" "$next" "$panel"
}

setup() {
  [[ -e $SETUP_MARKER ]] && { echo "already set up"; return 0; }
  setup_bar
  # its own process, so a failure (Hyprland not answering yet) cannot stop this one halfway;
  # without the marker, the next start tries again (the bar step above is safe to repeat)
  if ! "$0" setup-keys; then
    echo "shortcuts not turned on yet; trying again on the next start" >&2
    return 0
  fi
  mkdir -p "$STATE_DIR"
  : >"$SETUP_MARKER"
}

# Puts the built-in keyboard label back where OmaLangy is (or where it was), if setup took
# its place and it is not on the bar again already.
restore_bar() {
  [[ -f $REPLACED_FILE && -f $SHELL_JSON ]] || return 0
  local next
  next=$(jq --slurpfile saved "$REPLACED_FILE" "$JQ_FIND"'
    $saved[0] as $r
    | if find("omarchy.keyboard-layout") != null then .
      else (find("blackcode.omalangy") // {s: $r.section, i: $r.index}) as $at
        | .bar.layout[$at.s] = ((.bar.layout[$at.s] // []) | .[0:$at.i] + [$r.entry] + .[$at.i:])
      end' "$SHELL_JSON") || return 0
  write_shell_json "$next"
  rm -f "$REPLACED_FILE"
  echo "The built-in keyboard label is back on the bar."
}

uninstall() {
  restore_bar
  # a reinstall later sets itself up again
  rm -f "$SETUP_MARKER"
  if [[ -f $HYPRLAND_FILE ]] && grep -qF -e "$HOOK_LINE" "$HYPRLAND_FILE"; then
    local tmp
    cp "$HYPRLAND_FILE" "$HYPRLAND_FILE.bak.$(date +%s)"
    tmp=$(mktemp "$HYPRLAND_FILE.XXXXXX")
    # grep exits 1 when nothing is left; that is fine, so do not abort on it.
    if ! { grep -vxF -e "$HOOK_LINE" -e "$HOOK_MARKER" -e "$OLD_HOOK_MARKER" "$HYPRLAND_FILE" >"$tmp" || true; } ||
      # Drop the blank line the hook was appended after, if it is now trailing.
      ! sed -i -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$tmp" ||
      ! chmod --reference="$HYPRLAND_FILE" "$tmp" ||
      ! mv "$tmp" "$HYPRLAND_FILE"; then
      rm -f "$tmp"
      fail "could not update $HYPRLAND_FILE (left unchanged)"
    fi
  fi
  rm -f "$MODULE_FILE"
  hyprctl reload >/dev/null || true
  echo "Keyboard languages reset to your Hyprland config."
}

case "${1:-}" in
state) state ;;
switch) shift; switch_layout "$@" ;;
setup-keys) setup_keys ;;   # internal: run by setup, which holds the lock
apply | check | uninstall | setup)
  # One writer at a time: the bar runs one widget per monitor.
  mkdir -p "$LOCK_DIR"
  exec 9>"$LOCK_FILE"
  flock -w 10 9 || fail "another languagectl is still running"
  cmd="$1"; shift
  "$cmd" "$@"
  ;;
*)
  echo "Usage: languagectl state | apply <layouts> <variants> <alts|menu|rctrl|off> <next-key> <panel-key> | check | switch <index|next|prev> | setup | uninstall" >&2
  exit 1
  ;;
esac
